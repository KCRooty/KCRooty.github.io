# Copia este archivo como .env y rellénalo. El .env NUNCA se sube a GitHub.

# Turnstile (Cloudflare → Turnstile → Add widget, dominio staticforge.me, modo "Managed").
TURNSTILE_SITEKEY=
TURNSTILE_SECRET=

# Cadena aleatoria larga para firmar las sesiones.
# Linux/fish:  openssl rand -base64 48
# PowerShell:  [Convert]::ToBase64String((1..48 | % {Get-Random -Max 256}))
JWT_SECRET=

# Token del túnel (Cloudflare → Zero Trust → Networks → Tunnels → Create tunnel → Docker).
TUNNEL_TOKEN=
